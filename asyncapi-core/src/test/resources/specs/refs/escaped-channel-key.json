{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Echo",
    "version": "1.0.0"
  },
  "servers": {
    "prod": {
      "host": "example.com",
      "protocol": "wss"
    }
  },
  "channels": {
    "/ws": {
      "address": "/ws",
      "messages": {
        "ping": {
          "$ref": "#/components/messages/Ping"
        },
        "pong": {
          "$ref": "#/components/messages/Pong"
        }
      }
    }
  },
  "operations": {
    "sendPing": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/~1ws"
      },
      "messages": [
        {
          "$ref": "#/channels/~1ws/messages/ping"
        }
      ],
      "reply": {
        "channel": {
          "$ref": "#/channels/~1ws"
        },
        "messages": [
          {
            "$ref": "#/channels/~1ws/messages/pong"
          }
        ]
      }
    }
  },
  "components": {
    "messages": {
      "Ping": {
        "payload": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "ping"
            }
          }
        }
      },
      "Pong": {
        "payload": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "pong"
            }
          }
        }
      }
    }
  }
}
