{
  "asyncapi": "3.0.0",
  "info": {
    "title": "User Events API",
    "version": "1.0.0",
    "description": "API for user lifecycle events",
    "contact": {
      "name": "API Support",
      "email": "support@example.com"
    },
    "license": {
      "name": "Apache 2.0"
    }
  },
  "servers": {
    "webhookServer": {
      "host": "api.example.com",
      "protocol": "http",
      "pathname": "/{version}",
      "variables": {
        "version": {
          "enum": ["v1", "v2"],
          "default": "v1",
          "description": "API version",
          "examples": ["v1"]
        }
      }
    },
    "wsServer": {
      "host": "api.example.com",
      "protocol": "ws"
    }
  },
  "channels": {
    "userSignedUp": {
      "address": "/user/signed-up",
      "description": "Channel for user sign-up events",
      "bindings": {
        "http": {
          "method": "POST"
        }
      },
      "messages": {
        "UserSignedUp": {
          "payload": {
            "$ref": "#/components/schemas/UserPayload"
          }
        },
        "UserCommand": {
          "payload": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "userStream": {
      "address": "/user/stream",
      "description": "WebSocket channel for streaming user events",
      "bindings": {
        "ws": {
          "method": "GET"
        }
      },
      "messages": {
        "UserEvent": {
          "payload": {
            "$ref": "#/components/schemas/UserPayload"
          }
        }
      }
    }
  },
  "operations": {
    "receiveUserSignedUp": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/userSignedUp"
      },
      "messages": [
        { "$ref": "#/channels/userSignedUp/messages/UserSignedUp" }
      ]
    },
    "sendUserCommand": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/userSignedUp"
      },
      "messages": [
        { "$ref": "#/channels/userSignedUp/messages/UserCommand" }
      ]
    },
    "streamUserEvents": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/userStream"
      },
      "messages": [
        { "$ref": "#/channels/userStream/messages/UserEvent" }
      ]
    }
  },
  "components": {
    "serverVariables": {
      "sharedVersion": {
        "enum": ["v1", "v2", "beta"],
        "default": "v1",
        "description": "Shared API version variable",
        "examples": ["v2"]
      }
    },
    "schemas": {
      "UserPayload": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      }
    }
  }
}
