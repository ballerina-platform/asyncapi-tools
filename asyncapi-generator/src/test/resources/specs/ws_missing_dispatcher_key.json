{
  "asyncapi": "3.0.0",
  "info": {
    "title": "T",
    "version": "1"
  },
  "channels": {
    "chat": {
      "address": "/chat",
      "messages": {
        "Joined": {
          "payload": {"type": "object", "properties": {"user": {"type": "string"}}}
        },
        "Said": {
          "payload": {"type": "object", "properties": {"text": {"type": "string"}}}
        }
      }
    }
  },
  "operations": {
    "onJoined": {
      "action": "receive",
      "channel": {"$ref": "#/channels/chat"},
      "messages": [{"$ref": "#/channels/chat/messages/Joined"}]
    },
    "onSaid": {
      "action": "receive",
      "channel": {"$ref": "#/channels/chat"},
      "messages": [{"$ref": "#/channels/chat/messages/Said"}]
    }
  }
}
