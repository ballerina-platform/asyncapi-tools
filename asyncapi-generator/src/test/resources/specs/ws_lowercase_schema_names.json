{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Purchases",
    "version": "1.0.0"
  },
  "x-dispatcherKey": "type",
  "channels": {
    "purchases": {
      "address": "/",
      "messages": {
        "purchase": {
          "payload": {
            "$ref": "#/components/schemas/purchase"
          }
        }
      }
    }
  },
  "operations": {
    "sendPurchase": {
      "action": "send",
