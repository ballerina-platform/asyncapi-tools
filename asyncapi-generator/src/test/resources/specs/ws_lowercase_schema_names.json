        "$ref": "#/channels/purchases"
      },
      "messages": [
        {
          "$ref": "#/channels/purchases/messages/purchase"
        }
      ]
    }
  },
  "components": {
    "schemas": {
      "purchase": {
        "type": "object",
        "required": ["type", "status"],
        "properties": {
          "type": {"type": "string", "const": "purchase"},
          "status": {"$ref": "#/components/schemas/status"},
          "items": {"type": "array", "items": {"$ref": "#/components/schemas/item"}},
          "note": {"oneOf": [{"$ref": "#/components/schemas/status"}, {"$ref": "#/components/schemas/item"}]}
        }
      },
      "status": {
        "type": "string"
      },
      "item": {
        "type": "object",
        "properties": {
          "name": {"type": "string"}
        }
      }
    }
  }
