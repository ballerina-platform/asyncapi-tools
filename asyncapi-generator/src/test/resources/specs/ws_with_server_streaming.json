{
  "asyncapi": "2.0.0",
  "info": {
    "title": "Chat",
    "version": "1.0.0"
  },
  "x-dispatcherKey": "event",
  "channels": {
    "chat": {
      "publish": {
        "operationId": "sendChatMessage",
        "message": {
          "$ref": "#/components/messages/ChatSend"
        }
      }
    }
  },
  "components": {
    "messages": {
      "ChatSend": {
        "payload": {
          "$ref": "#/components/schemas/ChatSend"
        },
        "x-response": {
          "$ref": "#/components/messages/Pong"
        },
        "x-response-type": "server-streaming"
      },
      "Pong": {
        "payload": {
          "$ref": "#/components/schemas/Pong"
        }
      }
    },
    "schemas": {
      "ChatSend": {
        "type": "object",
        "required": ["event"],
        "properties": {
          "event": {"type": "string"},
          "message": {"type": "string"}
        }
      },
      "Pong": {
        "type": "object",
        "required": ["event"],
        "properties": {
          "event": {"type": "string"},
          "data": {"type": "string"}
        }
      }
    }
  }
}
